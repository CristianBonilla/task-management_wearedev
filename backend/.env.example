# ==========================================================================
# Django
# ==========================================================================
DJANGO_SECRET_KEY=change-me-in-production-please-use-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==========================================================================
# Database (PostgreSQL)
# Option A (preferred): a single DATABASE_URL.
# Option B: individual POSTGRES_* variables (used if DATABASE_URL is absent).
# ==========================================================================
DATABASE_URL=postgres://taskuser:taskpass@localhost:5432/taskdb

POSTGRES_DB=taskdb
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==========================================================================
# CORS — origins allowed to consume the API (Ionic dev server / device)
# ==========================================================================
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200,capacitor://localhost,http://localhost

# ==========================================================================
# Business rules
# ==========================================================================
# Default window (hours) for the "expiring soon" endpoint.
EXPIRING_WINDOW_HOURS=48
# Fixed user used for auditing when authentication is disabled.
DEFAULT_TASK_OWNER=system
